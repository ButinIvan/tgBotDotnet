@model List<News>
@{
    ViewData["Title"] = "Главная";
    var user = ViewBag.User as User;
    var classInfo = ViewBag.Class as Class;
    var classes = ViewBag.Classes as List<Class> ?? new List<Class>();
}

<h2>Добро пожаловать, @(user?.FirstName ?? "Администратор")!</h2>

@if (classInfo == null)
{
    <div class="alert alert-info">
        У вас пока нет доступных классов. Создайте класс через бота или дождитесь назначения модератором.
    </div>
}
else
{
    <div class="mb-3">
        <form method="get" action="/Home/Index" class="d-flex align-items-center gap-2">
            <label for="classId" class="form-label mb-0">Класс:</label>
            @Html.DropDownList("classId", new SelectList(classes, "Id", "Name", ViewBag.SelectedClassId), new { @class = "form-select", onchange = "this.form.submit()" })
            <noscript><button type="submit" class="btn btn-primary btn-sm">Выбрать</button></noscript>
        </form>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Последние новости и отчеты</h4>
        <a href="/News/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Создать
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var news in Model)
            {
                var preview = string.IsNullOrWhiteSpace(news.Content)
                    ? "Без текстового описания"
                    : news.Content.Length > 100 ? news.Content.Substring(0, 100) + "..." : news.Content;

                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between">
                            <span class="badge @(news.Type == NewsType.News ? "bg-info" : "bg-warning")">
                                @(news.Type == NewsType.News ? "Новость" : "Отчет")
                            </span>
                            <small class="text-muted">@AppDateTime.Format(news.CreatedAt)</small>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@news.Title</h5>
                            <p class="card-text">@preview</p>
                            <div class="btn-group">
                                <a href="/News/Edit/@news.Id" class="btn btn-sm btn-outline-primary">Редактировать</a>
                                <form method="post" action="/News/Delete/@news.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Удалить эту запись?')">Удалить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Пока нет новостей или отчетов. <a href="/News/Create">Создайте первую запись</a>.
        </div>
    }
}
