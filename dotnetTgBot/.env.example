# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=1234567890:replace_with_real_token

# PostgreSQL settings used by compose.yaml to create CONNECTION_STRING.
DB_NAME=tg_school_bot
DB_USERNAME=postgres
DB_PASSWORD=change_me

# RabbitMQ settings.
RABBITMQ_USER=tg_bot
RABBITMQ_PASSWORD=change_me
RABBITMQ_QUEUE=tg_bot_queue

# MinIO / S3 settings.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Public admin panel URL shown by the bot in /adminpanel.
ADMIN_PANEL_URL=http://localhost:5010

# Time zone used when displaying dates.
APP_TIME_ZONE=Europe/Moscow
